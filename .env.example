# Runtime
# PORT=3000
# DEBUG=false
# LOG_DIR=/app/logs
# SESSION_SECRET=replace-with-a-long-random-string
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://control.example.com

# Primary database: leave empty to use SQLite at SQLITE_PATH.
# SQL_DSN=postgresql://user:password@127.0.0.1:5432/subandnew
# SQLITE_PATH=/data/subandnew.db
# SQL_MAX_IDLE_CONNS=100
# SQL_MAX_OPEN_CONNS=1000
# SQL_MAX_LIFETIME=60
# SQLITE_MAX_OPEN_CONNS=1
# SQLITE_BUSY_TIMEOUT_MS=30000

# Optional shared session and rate-limit store.
# REDIS_CONN_STRING=redis://user:password@127.0.0.1:6379/0
# SYNC_FREQUENCY=60

# Required before storing credentials for managed New API or Sub2API instances.
# Generate a standard Base64 value containing exactly 32 random bytes.
# MANAGED_INSTANCE_SECRET_KEY=
# MANAGED_INSTANCE_SECRET_KEY_VERSION=v1
# MANAGED_INSTANCE_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
# MANAGED_INSTANCE_ALLOWED_PORTS=80,443,3000
# MANAGED_INSTANCE_PROBE_MAX_CONCURRENCY=8

# Optional OAuth endpoints.
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# NODE_TYPE=master
# NODE_NAME=control-plane-1
