# Runtime
# PORT=3000
# DEBUG=false
# LOG_DIR=/app/logs
# SESSION_SECRET=replace-with-a-long-random-string
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://control.example.com
# Comma-separated reverse-proxy IP/CIDR list. Empty means proxy headers are not trusted.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Primary database: leave empty to use SQLite at SQLITE_PATH.
# SQL_DSN=postgresql://user:password@127.0.0.1:5432/subandnew
# SQLITE_PATH=/data/subandnew.db
# SQL_MAX_IDLE_CONNS=100
# SQL_MAX_OPEN_CONNS=1000
# SQL_MAX_LIFETIME=60
# SQLITE_MAX_OPEN_CONNS=1
# SQLITE_BUSY_TIMEOUT_MS=30000

# Optional shared session and rate-limit store.
# REDIS_CONN_STRING=redis://user:password@127.0.0.1:6379/0
# SYNC_FREQUENCY=60

# Required before storing credentials for managed New API or Sub2API instances.
# Generate a standard Base64 value containing exactly 32 random bytes.
# MANAGED_INSTANCE_SECRET_KEY=
# MANAGED_INSTANCE_SECRET_KEY_VERSION=v1
# MANAGED_INSTANCE_PROBE_MAX_CONCURRENCY=8
# MANAGED_INSTANCE_OPERATION_MAX_CONCURRENCY=4
# MANAGED_INSTANCE_OPERATION_MAX_PER_HOST=2
# MANAGED_INSTANCE_BATCH_MAX_CONCURRENCY=2
# Outbound target policy used by managed instances and AI model endpoints.
# Private, loopback and special-purpose networks are blocked unless explicitly allowed.
# MANAGED_INSTANCE_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
# If set, include ilinkai.weixin.qq.com (and any official regional *.weixin.qq.com host) for WeChat.
# MANAGED_INSTANCE_ALLOWED_HOSTS=api.openai.com,ilinkai.weixin.qq.com,*.weixin.qq.com,*.trusted-model.example
# MANAGED_INSTANCE_ALLOWED_PORTS=443,8443

# AI assistant credential and conversation encryption (32 random bytes, standard Base64).
# When omitted, the server derives a domain-separated assistant key from
# MANAGED_INSTANCE_SECRET_KEY for backward-compatible deployments.
# ASSISTANT_SECRET_KEY=
# ASSISTANT_SECRET_CURRENT_KEY_VERSION=v1
# For rotation, replace the single key with a JSON keyring and keep old keys until data is re-encrypted:
# ASSISTANT_SECRET_KEYS={"v1":"base64-old-key","v2":"base64-current-key"}
# ASSISTANT_WORKER_ENABLED=true

# Optional persistent directory for background billing alert CSV exports.
# BILLING_ALERT_EXPORT_DIR=/data/exports/billing-alerts

# Optional OAuth endpoints.
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# NODE_TYPE=master
# NODE_NAME=control-plane-1
